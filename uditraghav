
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#080d1b">

  <title>Udit Raghav | Accountant & Accounts Professional</title>

  <meta name="description"
        content="Official portfolio of Udit Raghav, an accounts professional skilled in accounting, GST, Tally, billing and Microsoft Excel.">

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Space+Grotesk:wght@400;500;600;700&display=swap" rel="stylesheet">

  <style>
    :root {
      --bg: #080d1b;
      --panel: #10182b;
      --text: #f3f6ff;
      --muted: #a3aec5;
      --accent: #76a9ff;
      --purple: #b69cff;
      --border: rgba(255,255,255,.10);
    }

    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    html {
      scroll-behavior: smooth;
      scroll-padding-top: 90px;
    }

    body {
      background: var(--bg);
      color: var(--text);
      font-family: 'Inter', sans-serif;
      line-height: 1.7;
      overflow-x: hidden;
    }

    a {
      color: inherit;
      text-decoration: none;
    }

    .container {
      width: min(1100px, 90%);
      margin: auto;
    }

    .glow {
      position: fixed;
      width: 340px;
      height: 340px;
      border-radius: 50%;
      filter: blur(110px);
      opacity: .13;
      pointer-events: none;
      z-index: -1;
    }

    .glow.one {
      background: #4387ff;
      top: 0;
      left: -100px;
    }

    .glow.two {
      background: #9b5cff;
      right: -100px;
      top: 45%;
    }

    header {
      position: sticky;
      top: 0;
      z-index: 10;
      background: rgba(8,13,27,.86);
      backdrop-filter: blur(18px);
      border-bottom: 1px solid var(--border);
    }

    nav {
      min-height: 76px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 20px;
    }

    .logo {
      font-family: 'Space Grotesk', sans-serif;
      font-size: 23px;
      font-weight: 700;
    }

    .logo span {
      color: var(--accent);
    }

    .nav-links {
      display: flex;
      flex-wrap: wrap;
      gap: 23px;
      font-size: 13px;
      color: var(--muted);
    }

    .nav-links a:hover,
    .social a:hover {
      color: var(--accent);
    }

    .hero {
      min-height: 610px;
      display: flex;
      flex-direction: column;
      justify-content: center;
      padding: 95px 0 85px;
    }

    .eyebrow {
      color: var(--accent);
      font-size: 12px;
      font-weight: 700;
      letter-spacing: 3px;
      text-transform: uppercase;
      margin-bottom: 20px;
    }

    h1 {
      font-family: 'Space Grotesk', sans-serif;
      font-size: clamp(43px, 8vw, 78px);
      line-height: 1.08;
      letter-spacing: -3px;
      max-width: 850px;
    }

    h1 span {
      background: linear-gradient(100deg, #76a9ff, #c1a5ff);
      -webkit-background-clip: text;
      background-clip: text;
      color: transparent;
    }

    .hero p {
      color: var(--muted);
      max-width: 650px;
      margin-top: 25px;
      font-size: 16px;
    }

    .actions {
      display: flex;
      flex-wrap: wrap;
      gap: 14px;
      margin-top: 30px;
    }

    .btn {
      padding: 12px 21px;
      border: 1px solid var(--border);
      border-radius: 10px;
      font-weight: 600;
      font-size: 13px;
      transition: .25s;
      display: inline-flex;
      align-items: center;
      justify-content: center;
    }

    .btn.primary {
      color: #081020;
      background: linear-gradient(110deg, #76a9ff, #b69cff);
      border: none;
    }

    .btn:hover {
      transform: translateY(-3px);
      box-shadow: 0 10px 30px rgba(100,140,255,.15);
    }

    section {
      padding: 75px 0;
    }

    .section-label {
      color: var(--accent);
      text-transform: uppercase;
      letter-spacing: 3px;
      font-size: 11px;
      font-weight: 700;
    }

    h2 {
      font-family: 'Space Grotesk', sans-serif;
      font-size: clamp(30px, 5vw, 43px);
      line-height: 1.2;
      margin: 12px 0 18px;
      letter-spacing: -1px;
    }

    .section-intro {
      color: var(--muted);
      max-width: 690px;
      margin-bottom: 32px;
    }

    .grid {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 18px;
    }

    .card {
      padding: 25px;
      background: linear-gradient(145deg, rgba(19,29,51,.92), rgba(12,19,35,.95));
      border: 1px solid var(--border);
      border-radius: 16px;
      transition: transform .25s, border-color .25s;
    }

    .card:hover {
      transform: translateY(-5px);
      border-color: rgba(118,169,255,.5);
    }

    .icon {
      font-size: 27px;
      margin-bottom: 14px;
    }

    h3 {
      font-size: 17px;
      margin-bottom: 9px;
    }

    .card p, .card li {
      font-size: 13px;
      color: var(--muted);
    }

    .card ul {
      padding-left: 18px;
    }

    .about-layout {
      display: grid;
      grid-template-columns: 1.2fr .8fr;
      gap: 25px;
      align-items: stretch;
    }

    .about-copy {
      color: var(--muted);
      font-size: 15px;
    }

    .about-copy p + p {
      margin-top: 15px;
    }

    .facts {
      display: grid;
      gap: 12px;
    }

    .fact {
      background: var(--panel);
      border: 1px solid var(--border);
      border-radius: 12px;
      padding: 17px;
    }

    .fact small {
      display: block;
      color: var(--muted);
      font-size: 11px;
      margin-bottom: 3px;
    }

    .fact strong {
      font-size: 14px;
    }

    .skill-list {
      display: flex;
      flex-wrap: wrap;
      gap: 11px;
    }

    .skill {
      padding: 10px 15px;
      border-radius: 9px;
      border: 1px solid rgba(118,169,255,.22);
      background: rgba(118,169,255,.07);
      color: #d8e4ff;
      font-size: 13px;
    }

    .timeline {
      border-left: 1px solid rgba(118,169,255,.4);
      margin-left: 7px;
      padding-left: 25px;
    }

    .timeline-item {
      position: relative;
      padding: 0 0 28px;
    }

    .timeline-item::before {
      content: "";
      position: absolute;
      left: -31px;
      top: 8px;
      width: 11px;
      height: 11px;
      background: var(--accent);
      border-radius: 50%;
      box-shadow: 0 0 15px rgba(118,169,255,.4);
    }

    .timeline-item p {
      color: var(--muted);
      font-size: 14px;
      margin-top: 5px;
    }

    .contact-box {
      text-align: center;
      border: 1px solid var(--border);
      border-radius: 22px;
      padding: 45px 25px;
      background: radial-gradient(ellipse at top, rgba(91,120,220,.13), transparent 70%);
    }

    .contact-box h2 {
      margin-top: 10px;
    }

    .contact-box p {
      color: var(--muted);
      max-width: 600px;
      margin: 0 auto 25px;
    }

    .social {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: 12px;
      margin-top: 25px;
    }

    .social a {
      border: 1px solid var(--border);
      background: rgba(255,255,255,.03);
      border-radius: 10px;
      padding: 10px 15px;
      font-size: 12px;
      transition: .2s;
    }

    footer {
      border-top: 1px solid var(--border);
      padding: 25px 0;
      text-align: center;
      color: var(--muted);
      font-size: 12px;
    }

    .reveal {
      opacity: 0;
      transform: translateY(18px);
      transition: opacity .65s ease, transform .65s ease;
    }

    .reveal.visible {
      opacity: 1;
      transform: translateY(0);
    }

    @media (max-width: 760px) {
      nav {
        padding: 14px 0;
        align-items: flex-start;
        flex-direction: column;
      }

      .nav-links {
        gap: 14px;
      }

      .hero {
        min-height: 530px;
        padding: 75px 0;
      }

      h1 {
        letter-spacing: -1.5px;
      }

      .grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }

      .about-layout {
        grid-template-columns: 1fr;
      }
    }

    @media (max-width: 480px) {
      .grid {
        grid-template-columns: 1fr;
      }

      section {
        padding: 55px 0;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      html {
        scroll-behavior: auto;
      }

      *, *::before, *::after {
        transition-duration: .01ms !important;
      }

      .reveal {
        opacity: 1;
        transform: none;
      }
    }
  </style>
</head>

